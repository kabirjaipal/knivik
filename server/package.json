{
  "name": "knivik-server",
  "version": "1.0.0",
  "description": "AI Buying Intent Lead Finder - Scans online conversations to detect potential customers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx prisma generate && node esbuild.config.js",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "ai",
    "lead-generation",
    "intent-detection",
    "scraping",
    "saas",
    "b2b",
    "reddit",
    "hackernews"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/groq": "^4.0.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ai": "^7.0.65",
    "argon2": "^0.45.1",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.28",
    "bullmq": "^6.1.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dodopayments": "^2.46.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "resend": "^6.20.0",
    "snoowrap": "^1.23.0",
    "socket.io": "^4.8.3",
    "user-agents": "^2.1.152",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/snoowrap": "^1.19.0",
    "@types/socket.io": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "mysql2": "^3.17.0"
  }
}
