# ==============================================================================
# KNIVIK - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# --- Frontend & Public URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# --- Authentication (Better-Auth) ---
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_32_character_random_secret_here
BCRYPT_ROUNDS=12

# --- Google OAuth (Optional for Social Login) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# --- Database & Connection Pool ---
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/knivik?schema=public"

# --- AI & LLM Engine (Groq) ---
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Email Notifications (Resend API) ---
RESEND_API_KEY=your_resend_api_key
SMTP_FROM=no-reply@yourdomain.com

# --- Dodo Payments ---
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key
DODO_PAYMENTS_PRO_MONTHLY_PRODUCT_ID=your_monthly_product_id
DODO_PAYMENTS_PRO_YEARLY_PRODUCT_ID=your_yearly_product_id
NEXT_PUBLIC_DODO_PAYMENTS_PRO_MONTHLY_PRODUCT_ID=your_monthly_product_id
NEXT_PUBLIC_DODO_PAYMENTS_PRO_YEARLY_PRODUCT_ID=your_yearly_product_id

# --- Analytics & Telemetry (Optional) ---
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id
LOG_LEVEL=info
LOG_PRETTY=true

# --- Scraper & Cron Job Security ---
CRON_SECRET=your_cron_secret_token
SCRAPER_INTERVAL_MS=7200000

# --- Reddit API Scraper (Optional for Reddit direct auth) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=node:knivik:v1.0.0 (by /u/your_username)
