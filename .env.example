# ==============================================================================
# KNIVIK - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your own values.
# Never commit your .env file to version control.
# ==============================================================================

# --- Environment ---
NODE_ENV=development
PORT=3000

# --- Frontend & Public URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- Authentication (Better-Auth) ---
# Generate with: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_32_character_random_secret_here
BCRYPT_ROUNDS=12

# --- Google OAuth (Optional — for social login) ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# --- Database (PostgreSQL) ---
# Local: postgresql://user:password@localhost:5432/knivik?schema=public
# Hosted (e.g. Supabase, Neon, Aiven): paste your connection string here
DATABASE_URL="postgresql://user:password@localhost:5432/knivik?schema=public"

# --- AI & LLM Engine (Groq) ---
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- AI & LLM Engine (OpenRouter — optional fallback) ---
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Email Notifications (Resend API) ---
# Get your key at: https://resend.com
RESEND_API_KEY=your_resend_api_key
SMTP_FROM=no-reply@yourdomain.com

# --- Payments (Dodo Payments — optional, only needed for billing features) ---
# Get your keys at: https://dodopayments.com
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_key
DODO_PAYMENTS_PRO_MONTHLY_PRODUCT_ID=your_monthly_product_id
DODO_PAYMENTS_PRO_YEARLY_PRODUCT_ID=your_yearly_product_id
NEXT_PUBLIC_DODO_PAYMENTS_PRO_MONTHLY_PRODUCT_ID=your_monthly_product_id
NEXT_PUBLIC_DODO_PAYMENTS_PRO_YEARLY_PRODUCT_ID=your_yearly_product_id

# --- Analytics & Telemetry (all optional) ---
# PostHog: https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- Scraper, Queue & Cron Security ---
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_token
SCRAPER_INTERVAL_MS=7200000
ENABLE_QUEUE=true
SCRAPER_CONCURRENCY=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
TRUST_PROXY=true

# --- Database Seeding (used only by prisma/seed.ts) ---
SEED_OWNER_EMAIL=admin@example.com
SEED_OWNER_PASSWORD=ChangeMe123!
